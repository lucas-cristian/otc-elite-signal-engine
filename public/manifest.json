{
  "manifest_version": 3,
  "name": "OTC Elite Signal Engine",
  "version": "1.9.3",
  "description": "Signal-only quantitative laboratory for Pocket Option OTC research with frozen v1.8.2 scientific core and Phase 4 protocol-v4 temporal/raw-tick hardening",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "src/service-worker/core/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pocketoption.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/main-world/page-bridge.js",
        "src/common/protocol/pocket-option-parser.js",
        "src/common/hashing/canonical-hash.js",
        "src/common/hashing/sha256.js",
        "src/common/protocol/protocol-verification-registry.js",
        "src/common/protocol/shadow-market-policy.js"
      ],
      "matches": [
        "https://*.pocketoption.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/ui/popup/index.html"
  },
  "options_ui": {
    "page": "src/ui/dashboard/index.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "116"
}
