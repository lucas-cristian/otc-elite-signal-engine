{
  "name": "otc-elite-signal-engine",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build-test.mjs",
    "test": "npm run build:test && node --test .test-dist/tests/*.test.js",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run validate:manifest"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
