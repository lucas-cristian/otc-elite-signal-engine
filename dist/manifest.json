{
  "manifest_version": 3,
  "name": "OTC Elite Signal Engine",
  "version": "1.1.0",
  "description": "Signal-only quantitative laboratory for Pocket Option OTC reference-feed research",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "src/service-worker/core/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pocketoption.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/main-world/page-bridge.js",
        "src/common/protocol/pocket-option-parser.js",
        "src/common/hashing/canonical-hash.js",
        "src/common/hashing/sha256.js"
      ],
      "matches": [
        "https://*.pocketoption.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/ui/popup/index.html"
  },
  "options_ui": {
    "page": "src/ui/dashboard/index.html",
    "open_in_tab": true
  }
}
